# OpenAI Configuration (Required)
OPENAI_API_KEY=your_api_key_here

# Model Configuration
OPENAI_MODEL=gpt-4-1106-preview

# Assistant Configuration
ASSISTANT_NAME=Ok Computer
ASSISTANT_VOICE_ENABLED=true
ASSISTANT_ANIMATIONS_ENABLED=true
ASSISTANT_SUBTITLES_ENABLED=true
ASSISTANT_VOICE_RECOGNITION_ENABLED=true

# Operational Modes
LOW_DATA_MODE=true
ENABLE_SEMANTIC_ROUTER_MAP=true
ENABLE_OCR=false

# Database
DATABASE_PATH=history.db

# Logging
LOG_LEVEL=INFO
